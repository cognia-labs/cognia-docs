{
  "name": "@cognia/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "prebuild": "pnpm publication:check && pnpm artifacts:check",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build --webpack && node scripts/build/prepare-docs-pages.mjs",
    "start": "node scripts/serve-static.mjs --port 3001",
    "preview": "pnpm start",
    "preview:pages": "wrangler pages dev --port 8789 --ip 127.0.0.1",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:scripts": "node --test scripts/*.test.mjs scripts/build/*.test.mjs scripts/gates/*.test.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "publication:import": "node scripts/import-publication.mjs",
    "publication:check": "node scripts/import-publication.mjs --check",
    "artifacts:build": "node scripts/build/build-support-docs.mjs",
    "artifacts:check": "node scripts/build/build-support-docs.mjs --check",
    "audit:docs-links": "node scripts/gates/check-docs-links.mjs",
    "audit:adr-catalog": "node scripts/gates/check-adr-catalog.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:scripts && pnpm test && pnpm audit:docs-links && pnpm audit:adr-catalog && pnpm build",
    "deploy:check": "node scripts/prepare-deployment.mjs",
    "coverage:changed": "node scripts/changed-coverage.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "geist": "1.7.2",
    "mermaid": "12.0.0",
    "next": "16.4.2",
    "next-intl": "4.14.7",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unist-util-visit": "5.1.0",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "gray-matter": "4.0.3",
    "glob": "13.0.6",
    "commander": "15.0.0",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.5",
    "yaml": "2.9.1",
    "@testing-library/dom": "10.4.2",
    "wrangler": "4.141.0",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "license": "AGPL-3.0-only"
}
